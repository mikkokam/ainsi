# Slide 2 of the GFT deck. Governance is a separate role, above every runtime.
# Governance carries the detail; the runtimes are collapsed to what each one
# enforces. The platform's own internals are the deep-dive picture, not this one.

...@../../../../d2-style/theme/house

governance: GOVERNANCE {
  class: blue
  label.near: top-left

  decisions: |md <div style="text-align:center"><b>Decisions</b><br/><span style="color:#64748b">frameworks · risk appetite<br/>tier · control set · owner</span></div> | {class: icon; width: 200; icon: ../../../../d2-style/icons/lucide-scale.svg}
  oversight: |md <div style="text-align:center"><b>Oversight</b><br/><span style="color:#64748b">second line · reviews the<br/>evidence · reopens the tier</span></div> | {class: icon; width: 200; icon: ../../../../d2-style/icons/lucide-eye.svg}
}

runtimes: MANY RUNTIMES · EACH ENFORCES ITS OWN {
  class: slate
  label.near: top-left

  saas: |md <div style="text-align:center"><b>Copilots and SaaS AI</b><br/><span style="color:#64748b">the vendor's controls<br/>or none at all</span></div> | {class: icon; width: 190; icon: ../../../../d2-style/icons/lucide-cloud.svg}
  pipeline: |md <div style="text-align:center"><b>Build and deployment</b><br/><span style="color:#64748b">CI/CD policy gates</span></div> | {class: icon; width: 190; icon: ../../../../d2-style/icons/lucide-package.svg}

  platform: PLATFORM {
    class: amber
    label.near: top-left
    controlplane: |md <div style="text-align:center"><b>Control plane</b><br/><span style="color:#64748b">orchestration<br/>scheduling</span></div> | {class: icon; icon: ../../../../d2-style/icons/lucide-waypoints.svg}
    enforcement: |md <div style="text-align:center"><b>Enforcement point</b><br/><span style="color:#64748b">tool boundary<br/>approval gates</span></div> | {class: icon; width: 175; icon: ../../../../d2-style/icons/lucide-shield.svg}
  }
}

governance.decisions -> runtimes: the tier and the control set
governance.oversight <- runtimes: evidence · attestation · named gaps

(** -> **)[*].class: wire
(** <- **)[*].class: wireback
