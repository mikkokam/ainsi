# Slide 4 of the GFT deck. One control, and who owns each end of it.
# Deliberately a left-to-right flow, not the stacked bands of the two slides
# before it: the argument here is the interface, not the separation.
# Blue at both ends and slate in the middle is the whole claim in colour.

...@../../../../d2-style/theme/house

direction: right

authored: AUTHORED ONCE, IN GOVERNANCE {
  class: blue
  label.near: top-left

  prose: |md <div style="text-align:center"><b>For the person</b><br/><span style="color:#64748b">prose a reviewer<br/>can sign off</span></div> | {class: icon; width: 170; icon: ../../../../d2-style/icons/lucide-scroll-text.svg}
  params: |md <div style="text-align:center"><b>For the machine</b><br/><span style="color:#64748b">parameters · thresholds<br/>when it applies</span></div> | {class: icon; width: 200; icon: ../../../../d2-style/icons/lucide-list-checks.svg}
}

runtime: ENFORCED BY YOU · YOUR TEAM WRITES THE RULE {
  class: slate
  label.near: top-left

  engines: |md <div style="text-align:center"><b>Policy engines</b><br/><span style="color:#64748b">Rego · Cedar</span></div> | {class: icon; width: 160; icon: ../../../../d2-style/icons/lucide-code-xml.svg}
  gates: |md <div style="text-align:center"><b>Platform gates</b><br/><span style="color:#64748b">approvals<br/>tool boundary</span></div> | {class: icon; width: 160; icon: ../../../../d2-style/icons/lucide-stamp.svg}
  gateways: |md <div style="text-align:center"><b>Model gateways</b><br/><span style="color:#64748b">filters · limits</span></div> | {class: icon; width: 170; icon: ../../../../d2-style/icons/lucide-funnel.svg}
}

proven: PROVEN BACK, IN GOVERNANCE {
  class: blue
  label.near: top-left

  evidence: |md <div style="text-align:center"><b>The event that proves it</b><br/><span style="color:#64748b">attached to the control<br/>on the system it belongs to</span></div> | {class: icon; width: 230; icon: ../../../../d2-style/icons/lucide-file-text.svg}
}

authored -> runtime: itemised, with its parameters\nread over the API
runtime -> proven: observability events

(** -> **)[*].class: wire
(** <- **)[*].class: wireback
