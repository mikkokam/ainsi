node_modules/
bun.lock
*.html
!samples/**/*.html
# the studio's start page is source, not a built deck
!src/studio/*.html
# built for others to continue in; not source
*.pptx

# editor and agent local settings
.zed/
.claude/

.DS_Store

# joined source written by the d2 render script in --watch mode
.*.d2

# built decks; the html beside a sample is the demo, a pdf is not
*.pdf
# what "Deck and its files…" writes beside the deck it packed
*.zip

# a deck made by accident: New writes untitled.md into whatever folder the studio was started
# in, and the next one is untitled-2.md
untitled.md
untitled-*.md

# secrets; bun loads this by itself and it never leaves the machine
.env
.env.*

# desktop shells: toolchain projections and build output
desktop/*/.hutch/
desktop/*/build/
desktop/*/hutch.lock
desktop/.*.hutch-template.lock
desktop/*/artifacts/
desktop/*/.cottontail-tmp/
design_handoff_ainsi_chrome/
design_handoff_ainsi_chrome 2/
